# 管理员引导邀请码（首次注册用；上线前务必修改）
BOOTSTRAP_CODE=park-founder-2026

# 会话签名密钥（生产必填）：openssl rand -hex 32
SESSION_SECRET=

# 数据库：默认本地 SQLite；使用 Turso 时填写
TURSO_DATABASE_URL=file:./data/park.db
TURSO_AUTH_TOKEN=

# 本地图片目录
UPLOAD_DIR=./uploads

# 可选：S3 / Cloudflare R2 对象存储（配置后优先使用，未配置回落到 UPLOAD_DIR）
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
